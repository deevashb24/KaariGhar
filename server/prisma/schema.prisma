generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  passwordHash    String
  name            String
  role            String      // 'CUSTOMER' or 'MAKER'
  phone           String?
  city            String?
  bio             String?
  profileDetails  String?     // Can store JSON string of maker details
  isProfileComplete Boolean   @default(false)
  // --- Maker professional fields ---
  shopName        String?
  shopAddress     String?
  licenseNumber   String?     // GST / Trade License
  yearsExperience Int?
  materials       String?     // Comma-separated: "Teak,Sheesham,Plywood"
  workingHours    String?     // e.g. "Mon-Sat, 9 AM - 7 PM"
  deliveryRadius  String?     // e.g. "50 km"
  availability    String      @default("AVAILABLE") // AVAILABLE, BUSY, ON_VACATION
  latitude        Float?
  longitude       Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  requests        Request[]   @relation("CustomerRequests")
  quotes          Quote[]     @relation("MakerQuotes")
  sentMessages    Message[]   @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")
  reviewsGiven    Review[]    @relation("CustomerReviews")
  reviewsReceived Review[]    @relation("MakerReviews")
  favoritedBy     Favorite[]  @relation("FavoritedMaker")
  favorites       Favorite[]  @relation("CustomerFavorites")
  portfolio       PortfolioItem[]
  notifications   Notification[]
}

model Request {
  id              String      @id @default(uuid())
  customerId      String
  customer        User        @relation("CustomerRequests", fields: [customerId], references: [id])
  title           String
  description     String
  specs           String?     // Structured JSON string of specifications
  budget          Float?
  status          String      @default("OPEN") // OPEN, QUOTED, IN_PROGRESS, COMPLETED
  images          String?     // JSON array of image URLs (legacy)
  attachments     String?     // JSON array of unlimited media links (YouTube, Insta, images, etc.)
  aiInsights      String?     // AI-generated helpful insights for the Craftsman
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  quotes          Quote[]
}

model Quote {
  id              String      @id @default(uuid())
  requestId       String
  request         Request     @relation(fields: [requestId], references: [id])
  makerId         String
  maker           User        @relation("MakerQuotes", fields: [makerId], references: [id])
  price           Float
  message         String
  proposedTimeline String?
  status          String      @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  order           Order?
}

model Order {
  id              String      @id @default(uuid())
  quoteId         String      @unique
  quote           Quote       @relation(fields: [quoteId], references: [id])
  status          String      @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  totalPrice      Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  milestones      Milestone[]
}

model Milestone {
  id              String      @id @default(uuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id])
  title           String
  description     String
  amount          Float
  status          String      @default("PENDING") // PENDING, COMPLETED, PAID
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Message {
  id              String      @id @default(uuid())
  senderId        String
  sender          User        @relation("SentMessages", fields: [senderId], references: [id])
  receiverId      String
  receiver        User        @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content         String
  timestamp       DateTime    @default(now())
  read            Boolean     @default(false)
}

model Review {
  id              String      @id @default(uuid())
  orderId         String      @unique
  customerId      String
  customer        User        @relation("CustomerReviews", fields: [customerId], references: [id])
  makerId         String
  maker           User        @relation("MakerReviews", fields: [makerId], references: [id])
  rating          Int         // 1-5
  comment         String?
  createdAt       DateTime    @default(now())
}

model Favorite {
  id              String      @id @default(uuid())
  customerId      String
  customer        User        @relation("CustomerFavorites", fields: [customerId], references: [id])
  makerId         String
  maker           User        @relation("FavoritedMaker", fields: [makerId], references: [id])
  createdAt       DateTime    @default(now())

  @@unique([customerId, makerId])
}

model PortfolioItem {
  id              String      @id @default(uuid())
  makerId         String
  maker           User        @relation(fields: [makerId], references: [id])
  imageUrl        String      // Base64 data URL or external URL
  caption         String?
  category        String?     // e.g. "Bedroom", "Living Room", "Office"
  createdAt       DateTime    @default(now())
}

model Notification {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  type            String      // QUOTE_RECEIVED, ORDER_UPDATE, MESSAGE, REVIEW
  title           String
  message         String
  link            String?     // Optional deep link
  read            Boolean     @default(false)
  createdAt       DateTime    @default(now())
}
